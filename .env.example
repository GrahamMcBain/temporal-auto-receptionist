# Temporal Cloud — used by the Vercel API routes and the always-on Worker.
TEMPORAL_ADDRESS=your-namespace.account.tmprl.cloud:7233
TEMPORAL_NAMESPACE=your-namespace.account
TEMPORAL_API_KEY=replace-with-a-temporal-cloud-api-key
TEMPORAL_TASK_QUEUE=auto-receptionist

# Worker container health endpoint.
WORKER_HEALTH_PORT=8080

# Set in Vercel if the browser is hosted on another origin.
ALLOWED_ORIGIN=https://your-vercel-project.vercel.app
